{
    "cli": {
        "version": ">= 3.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "environment": "development"
        },
        "preview": {
            "distribution": "internal",
            "ios": {
                "simulator": true
            },
            "channel": "preview",
            "android": {
                "buildType": "apk"
            },
            "environment": "preview"
        },
        "production": {
            "channel": "production",
            "environment": "production"
        }
    },
    "submit": {
        "production": {}
    }
}
