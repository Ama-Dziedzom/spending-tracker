{
  "expo": {
    "name": "LogIt",
    "slug": "spending-tracker",
    "owner": "ama1",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/logit-app-icon/icon.png",
    "scheme": "logit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ama.spendingtracker",
      "appleTeamId": "9UJVR384QQ",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1642E5",
        "foregroundImage": "./assets/logit-app-icon/adaptive-icon.png",
        "backgroundImage": "./assets/logit-app-icon/adaptive-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.ama.spendingtracker"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/logit-app-icon/favicon.png"
    },
    "plugins": [
      "./plugins/withShareExtension",
      "./plugins/withWidget",
      "./plugins/withAndroidSmsReceiver",
      "./plugins/withAndroidWidget",
      "./plugins/withXcode27Fixes",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logit-app-icon/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1642E5",
          "dark": {
            "backgroundColor": "#081750"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDUsageDescription": "Allow LogIt to use FaceID for secure login."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LogIt uses the microphone only while you hold the mic in Ask LogIt, to hear your question.",
          "speechRecognitionPermission": "LogIt turns your spoken question into text so it can answer it. Audio isn't kept.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7cf11da-17b2-47d1-9e56-9e9f043b4bc4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a7cf11da-17b2-47d1-9e56-9e9f043b4bc4",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
