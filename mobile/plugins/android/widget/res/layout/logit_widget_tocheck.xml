<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/logit_widget_bg_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:padding="3dp"
            android:background="@drawable/logit_widget_circle_tint" android:src="@drawable/logit_ic_flash" android:tint="@color/logit_brand_accent_text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:text="To check" android:textSize="11sp" android:textColor="@color/logit_text_secondary" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <ImageView android:id="@+id/tile" android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp" android:background="@drawable/logit_widget_tile"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <ImageView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:tint="@color/logit_text_primary"/>
    <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="@color/logit_text_secondary" android:fontFamily="sans-serif" android:maxLines="1"/>
</LinearLayout>
