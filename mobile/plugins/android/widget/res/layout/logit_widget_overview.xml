<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/logit_widget_bg_surface">
    <LinearLayout android:id="@+id/top" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="14dp" android:background="@drawable/logit_widget_bg_blue_top">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:padding="3dp"
            android:background="@drawable/logit_widget_circle_onblue" android:src="@drawable/logit_ic_flash" android:tint="#FFFFFFFF"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:text="This week" android:textSize="11sp" android:textColor="#D9FFFFFF" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="#BFFFFFFF" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="GHS"
            android:textSize="10sp" android:textColor="#BFFFFFFF" android:fontFamily="sans-serif-medium"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <ImageView android:id="@+id/amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp"
                    android:textColor="#D9FFFFFF" android:fontFamily="sans-serif" android:textStyle="bold"/>
            </LinearLayout>
            <ImageView android:id="@+id/bars" android:layout_width="82dp" android:layout_height="30dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp">
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <ImageView android:id="@+id/tile1" android:layout_width="26dp" android:layout_height="26dp" android:padding="6dp" android:background="@drawable/logit_widget_tile"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/name1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
                    android:textColor="@color/logit_text_primary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/meta1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp"
                    android:textColor="@color/logit_text_secondary" android:fontFamily="sans-serif" android:maxLines="1"/>
            </LinearLayout>
            <TextView android:id="@+id/amount1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="@color/logit_text_primary" android:fontFamily="sans-serif" android:textStyle="bold"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/divider1" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/logit_line_default"/>
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <ImageView android:id="@+id/tile2" android:layout_width="26dp" android:layout_height="26dp" android:padding="6dp" android:background="@drawable/logit_widget_tile"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/name2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
                    android:textColor="@color/logit_text_primary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/meta2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp"
                    android:textColor="@color/logit_text_secondary" android:fontFamily="sans-serif" android:maxLines="1"/>
            </LinearLayout>
            <TextView android:id="@+id/amount2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="@color/logit_text_primary" android:fontFamily="sans-serif" android:textStyle="bold"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/divider2" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/logit_line_default"/>
        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <ImageView android:id="@+id/tile3" android:layout_width="26dp" android:layout_height="26dp" android:padding="6dp" android:background="@drawable/logit_widget_tile"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/name3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
                    android:textColor="@color/logit_text_primary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/meta3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp"
                    android:textColor="@color/logit_text_secondary" android:fontFamily="sans-serif" android:maxLines="1"/>
            </LinearLayout>
            <TextView android:id="@+id/amount3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="@color/logit_text_primary" android:fontFamily="sans-serif" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
            android:paddingTop="12dp" android:text="Nothing logged yet this week." android:textSize="11sp"
            android:textColor="@color/logit_text_secondary" android:fontFamily="sans-serif"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/ask" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:background="@drawable/logit_widget_capsule_muted">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/logit_ic_sparkle" android:tint="@color/logit_brand_accent_text"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Ask LogIt"
                android:textSize="11sp" android:textColor="@color/logit_text_tertiary" android:fontFamily="sans-serif-medium"/>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:padding="6dp" android:src="@drawable/logit_ic_mic"
                android:tint="#FFFFFFFF" android:background="@drawable/logit_widget_circle_accent"/>
        </LinearLayout>
        <ImageView android:id="@+id/paste" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:padding="9dp"
            android:src="@drawable/logit_ic_paste" android:tint="@color/logit_text_secondary" android:background="@drawable/logit_widget_circle_muted"/>
    </LinearLayout>
</LinearLayout>
